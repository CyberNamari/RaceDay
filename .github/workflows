name: CI

on:
  push:
    branches: [ "**" ]
  pull_request:
    branches: [ main ]

jobs:
  validate-deliverables:
    name: Check required docs exist
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Verify Section A, B, C deliverables are present
        run: |
          test -f docs/ERD.png && echo "✔ ERD.png found"
          test -f docs/API_Endpoint_Plan.md && echo "✔ API_Endpoint_Plan.md found"
          test -f docs/raceday_schema.sql && echo "✔ raceday_schema.sql found"

  lint-sql:
    name: Validate SQL script syntax
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install sqlfluff
        run: pip install sqlfluff

      - name: Parse raceday_schema.sql (T-SQL dialect)
        run: sqlfluff parse docs/raceday_schema.sql --dialect tsql

  build-and-test:
    name: Build API and run unit tests
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up .NET
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: "8.0.x"

      - name: Restore dependencies
        run: dotnet restore RaceDay.sln

      - name: Build
        run: dotnet build RaceDay.sln --configuration Release --no-restore

      - name: Run unit tests
        run: dotnet test RaceDay.sln --configuration Release --no-build --verbosity normal