@model List<RegistrationDto>
@{
    ViewData["Title"] = "Results entry";
    var eventId = (int)ViewBag.EventId;
    var statuses = new[] { "Finished", "DNF", "DQ" };
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h1 class="mb-0">Results entry</h1>
        <p class="text-muted mb-0">@ViewBag.EventName <partial name="_StatusBadge" model="(string)ViewBag.EventStatus" /></p>
    </div>
    <div class="d-flex gap-2">
        <form asp-action="Publish" asp-route-id="@eventId" method="post"
              onsubmit="return confirm('Publish results and mark this event as Completed?');">
            <button class="btn btn-rd">Publish results</button>
        </form>
        <a class="btn btn-outline-secondary" asp-controller="ManageEvents" asp-action="Index">Back</a>
    </div>
</div>

<p class="text-muted">Enter each participant's finish time (hh:mm:ss) and positions, then click Save on that row. Saved results show on the participant's My Results page.</p>

@if (!Model.Any())
{
    <div class="alert alert-info">Nobody has enrolled in this event, so there are no results to enter.</div>
}
else
{
    <div class="card rd-card p-3">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr><th>Bib</th><th>Participant</th><th>Category</th><th>Finish time</th><th>Overall</th><th>Category pos.</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        var formId = "f" + r.RegistrationId;
                        <tr>
                            <td>@(r.BibNumber ?? "-")</td>
                            <td>@r.ParticipantName</td>
                            <td>@r.CategoryName</td>
                            <td>
                                <input form="@formId" type="time" step="1" name="FinishTime" class="form-control form-control-sm"
                                       value="@(r.Result?.FinishTime?.ToString("HH:mm:ss"))" />
                            </td>
                            <td>
                                <input form="@formId" type="number" min="1" name="OverallPosition" class="form-control form-control-sm" style="width:90px"
                                       value="@r.Result?.OverallPosition" />
                            </td>
                            <td>
                                <input form="@formId" type="number" min="1" name="CategoryPosition" class="form-control form-control-sm" style="width:90px"
                                       value="@r.Result?.CategoryPosition" />
                            </td>
                            <td>
                                <select form="@formId" name="Status" class="form-select form-select-sm">
                                    @foreach (var s in statuses)
                                    {
                                        <option value="@s" selected="@((r.Result?.Status ?? "Finished") == s)">@s</option>
                                    }
                                </select>
                            </td>
                            <td class="text-end">
                                <form id="@formId" asp-action="Save" method="post">
                                    <input type="hidden" name="EventId" value="@eventId" />
                                    <input type="hidden" name="RegistrationId" value="@r.RegistrationId" />
                                    <input type="hidden" name="ResultId" value="@r.Result?.ResultId" />
                                    <button class="btn btn-sm @(r.Result is null ? "btn-rd" : "btn-outline-secondary")">@(r.Result is null ? "Save" : "Update")</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}