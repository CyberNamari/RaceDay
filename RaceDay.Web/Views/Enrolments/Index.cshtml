@model List<RegistrationDto>
@{
    ViewData["Title"] = "My Enrolments";
}

<h1 class="mb-3">My Enrolments</h1>

@if (ViewBag.Error is string err)
{
    <div class="alert alert-danger">@err</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        You haven't enrolled in any events yet.
        <a asp-controller="Home" asp-action="Index">Browse upcoming events</a>.
    </div>
}
else
{
    <div class="card rd-card p-3">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Bib</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td><a asp-controller="Events" asp-action="Details" asp-route-id="@r.EventId">@r.EventName</a></td>
                            <td>@r.EventDate.ToString("d MMM yyyy")</td>
                            <td>@r.CategoryName</td>
                            <td>@(r.BibNumber ?? "-")</td>
                            <td><partial name="_StatusBadge" model="r.PaymentStatus" /></td>
                            <td class="text-end">
                                @if (r.Result is null)
                                {
                                    <form asp-action="Cancel" method="post" onsubmit="return confirm('Cancel this enrolment?');">
                                        <input type="hidden" name="registrationId" value="@r.RegistrationId" />
                                        <button class="btn btn-outline-danger btn-sm">Cancel</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}