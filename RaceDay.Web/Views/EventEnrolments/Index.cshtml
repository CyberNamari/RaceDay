@model List<RegistrationDto>
@{
    ViewData["Title"] = "Enrolments";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h1 class="mb-0">Enrolments</h1>
        <p class="text-muted mb-0">@ViewBag.EventName</p>
    </div>
    <a class="btn btn-outline-secondary" asp-controller="ManageEvents" asp-action="Index">Back to events</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Nobody has enrolled yet.</div>
}
else
{
    <div class="card rd-card p-3">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Bib</th><th>Participant</th><th>Category</th><th>Enrolled</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>@(r.BibNumber ?? "-")</td>
                            <td>@r.ParticipantName</td>
                            <td>@r.CategoryName</td>
                            <td>@r.RegistrationDate.ToString("d MMM yyyy")</td>
                            <td><partial name="_StatusBadge" model="r.PaymentStatus" /></td>
                            <td class="text-end">
                                @if (r.PaymentStatus == "Pending")
                                {
                                    <form asp-action="Confirm" method="post">
                                        <input type="hidden" name="registrationId" value="@r.RegistrationId" />
                                        <input type="hidden" name="eventId" value="@((int)ViewBag.EventId)" />
                                        <button class="btn btn-success btn-sm">Confirm</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}