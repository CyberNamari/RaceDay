@model List<ManageEventRowViewModel>
@{
    ViewData["Title"] = "Manage Events";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="mb-0">Manage Events</h1>
    <a class="btn btn-rd" asp-action="Create">+ New event</a>
</div>

@if (ViewBag.Error is string err)
{
    <div class="alert alert-danger">@err</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">You haven't created any events yet.</div>
}
else
{
    <div class="card rd-card p-3">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr><th>Event</th><th>Type</th><th>Date</th><th>Location</th><th>Distances</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td>@r.Event.EventName</td>
                            <td>@r.Event.EventType</td>
                            <td>@r.Event.EventDate.ToString("d MMM yyyy")<br /><small class="text-muted">@r.Event.StartTime.ToString("HH:mm")</small></td>
                            <td>@r.Event.VenueName, @r.Event.City</td>
                            <td>@r.Distances</td>
                            <td><partial name="_StatusBadge" model="r.Event.Status" /></td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-id="@r.Event.EventId">Edit</a>
                                <form asp-action="Delete" asp-route-id="@r.Event.EventId" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this event? This cannot be undone.');">
                                    <button class="btn btn-outline-danger btn-sm">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}