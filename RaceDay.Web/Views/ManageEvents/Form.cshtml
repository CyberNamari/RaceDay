@model EventFormViewModel
@{
    var isEdit = Model.EventId != 0;
    ViewData["Title"] = isEdit ? "Edit event" : "New event";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card rd-card p-4">
            <h2 class="mb-3">@ViewData["Title"]</h2>

            <form method="post" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.EventId.ToString() : null)">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="VenueName" />

                <div class="mb-3">
                    <label asp-for="EventName" class="form-label"></label>
                    <input asp-for="EventName" class="form-control" />
                    <span asp-validation-for="EventName" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="EventType" class="form-label"></label>
                        <select asp-for="EventType" class="form-select">
                            <option>Run</option>
                            <option>Walk</option>
                            <option>Cycle</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="EventDate" class="form-label"></label>
                        <input type="date" name="EventDate" id="EventDate" class="form-control"
                               value="@(Model.EventDate?.ToString("yyyy-MM-dd"))" />
                        <span asp-validation-for="EventDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="StartTime" class="form-label"></label>
                        <input type="time" name="StartTime" id="StartTime" class="form-control"
                               value="@(Model.StartTime?.ToString("HH:mm"))" />
                        <span asp-validation-for="StartTime" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="VenueId" class="form-label"></label>
                    @if (!isEdit)
                    {
                        <select asp-for="VenueId" class="form-select">
                            <option value="0">Choose a venue...</option>
                            @foreach (var v in Model.Venues)
                            {
                                <option value="@v.VenueId">@v.VenueName, @v.City</option>
                            }
                        </select>
                        <span asp-validation-for="VenueId" class="text-danger"></span>
                        <div class="form-text">Venue not listed? <a asp-controller="Venues" asp-action="Create">Add a new venue</a>.</div>
                    }
                    else
                    {
                        <input class="form-control" value="@Model.VenueName" disabled />
                        <div class="form-text">The venue can't be changed after an event is created.</div>
                    }
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                @if (isEdit)
                {
                    <div class="mb-3">
                        <label asp-for="Status" class="form-label"></label>
                        <select asp-for="Status" class="form-select">
                            <option>Scheduled</option>
                            <option>Cancelled</option>
                            <option>Completed</option>
                        </select>
                        <div class="form-text">Set to Completed after the race, then capture results.</div>
                    </div>
                }

                <button class="btn btn-rd">@(isEdit ? "Save changes" : "Create event")</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}